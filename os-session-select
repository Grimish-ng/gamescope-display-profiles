#!/usr/bin/bash
exec > >(logger -t os-session-select) 2>&1
echo "os-session-select called with: $@"

SESSION="${1:-gamescope}"

case "$SESSION" in
    desktop|plasma)
        echo "switching to plasma"
        pkexec /usr/lib/steamos/steam-set-session plasma.desktop
        touch "${XDG_RUNTIME_DIR:-/run/user/1000}/steamos-switch-to-desktop"
        steam -shutdown
        ;;
    gamescope|steam)
        echo "switching to gamescope"
        pkexec /usr/lib/steamos/steam-set-session gamescope-wayland.desktop
        pkexec /usr/bin/systemctl restart plasmalogin.service
        ;;
esac
